cd "D:\JUAN CARLOS\JUANC\APLICATIVOS WEB\gestor-expedientes-web"

# Sobrescribe vercel.json con configuración completa
Set-Content -Path "vercel.json" -Value @"
{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ]
}
"@

# Sube a GitHub
git add vercel.json
git commit -m "Actualiza vercel.json v2 - fuerza nuevo deploy"
git push origin main